{
  "rewrites": [
    {
      "source": "/api/music/catalog",
      "destination": "/api/tracks?catalog=1"
    },
    {
      "source": "/ver",
      "destination": "/vista.html"
    },
    {
      "source": "/codigo/:id",
      "destination": "/codigo.html?id=:id"
    },
    {
      "source": "/musica",
      "destination": "/musica.html"
    },
    {
      "source": "/noticias",
      "destination": "/noticias.html"
    },
    {
      "source": "/noticias/:slug",
      "destination": "/api/articles?render=1&slug=:slug"
    },
    {
      "source": "/videos/:slug",
      "destination": "/index.html"
    }
  ]
}