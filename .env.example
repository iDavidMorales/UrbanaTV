# UrbanaTV ya no usa base de datos (sin Neon): el catálogo de música vive
# en mp3/catalog.json y las noticias en data/articles.json (archivos
# locales del repo). No se necesita DATABASE_URL.
# AUTH_SECRET sigue validando las sesiones ya emitidas (cookie
# urbanatv_session) que usa /api/tracks (POST); ya no se emiten sesiones
# nuevas desde el sitio. /api/upload ya no pide sesión: emite el token
# de subida a Blob para el formulario local, solo con límites de ruta,
# tipo y tamaño.
AUTH_SECRET=use_a_random_64_character_secret_generated_locally
# BLOB_READ_WRITE_TOKEN lo pone Vercel al conectar el store de Blob; se
# usa para listar las canciones subidas (mp3/catalog/*.json) y para las
# subidas desde el formulario (portadas y MP3). Sin él, el catálogo usa
# solo mp3/catalog.json y el formulario no puede subir archivos.
# BLOB_READ_WRITE_TOKEN=
